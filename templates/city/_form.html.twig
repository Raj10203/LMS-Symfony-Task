<div class="container-fluid">
{{ form_start(form) }}
{{ form_row(form.name) }}
<div id="city-fields" class="w-full">
</div>
{% if button_label is not defined %}
<a type="button" style="color: blue" id="add-city">Add more</a>
{% endif %}
{{ form_widget(form) }}
<button class="btn btn-primary">{{ button_label|default('Save') }}</button>

{{ form_end(form) }}
</div>
