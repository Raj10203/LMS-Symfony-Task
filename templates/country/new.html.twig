{% extends 'base.html.twig' %}

{% block title %}New Country{% endblock %}

{% set current_page = 'aside-menu-country' %}

{% block body %}
    <div class="card pb-5">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Create New Country</h5>
            <div>
                <a href="{{ path('app_country_index') }}" class="btn btn-secondary">
                    <i class="bx bx-arrow-back me-0 me-sm-1"></i>
                    <span class="d-none d-sm-inline-block">Back to List</span>
                </a>
                <a href="{{ path('app_country_new') }}" class="btn btn-primary">
                    <i class="bx bx-plus me-0 me-sm-1"></i>
                    <span class="d-none d-sm-inline-block">Add Country</span>
                </a>
            </div>
        </div>
        <div class="container-fluid">
        {{ include('country/_form.html.twig') }}
        </div>
    </div>
{% endblock %}
