{% extends 'base.html.twig' %}

{% block title %}Country index{% endblock %}

{% set current_page = 'aside-menu-country' %}

{% block body %}
    <!-- Address List Card -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Countries</h5>
            <a href="{{ path('app_country_new') }}" class="btn btn-primary">
                <i class="bx bx-plus me-0 me-sm-1"></i>
                <span class="d-none d-sm-inline-block">Add Country</span>
            </a>
        </div>
        <div class="table-responsive text-nowrap scrollable-container overflow-hidden">
            <table class="table datatable table-hover table-bordered">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>CreatedAt</th>
                    <th>UpdatedAt</th>
                    <th>actions</th>
                </tr>
                </thead>
                <tbody>
                {% for country in countries %}
                    <tr>
                        <td>{{ country.id }}</td>
                        <td>{{ country.name }}</td>
                        <td>{{ country.createdAt ? country.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                        <td>{{ country.updatedAt ? country.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                        <td>
                            <a href="{{ path('app_country_show', {'id': country.id}) }}">
                                <button class="btn btn-primary">
                                    <i class='bx bx-show'  ></i>
                                </button>
                            </a>
                            <a href="{{ path('app_country_edit', {'id': country.id}) }}">
                                <button class="btn btn-success">
                                    <i class='bx bx-edit'></i>
                                </button>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
