{% extends 'base.html.twig' %}

{% block title %}Edit Address{% endblock %}

{% set current_page = 'aside-menu-address' %}

{% block body %}

    <!-- Address List Card -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Edit Address</h5>
            <a href="{{ path('app_address_index') }}" class="btn btn-secondary">
                <i class="bx bx-plus me-0 me-sm-1"></i>
                <span class="d-none d-sm-inline-block">Back to List</span>
            </a>
            <a href="{{ path('app_address_new') }}" class="btn btn-primary">
                <i class="bx bx-plus me-0 me-sm-1"></i>
                <span class="d-none d-sm-inline-block">Add Address</span>
            </a>
        </div>
        <div class="table-responsive text-nowrap scrollable-container overflow-hidden">
            <div class="container-fluid">

                {{ include('address/_form.html.twig', {'button_label': 'Update'}) }}

                {{ include('address/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block additional_js %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('#address_form_country').on('change', function () {
                const countryId = $(this).val();
                const $citySelect = $('#address_form_city');

                $citySelect.html('<option value="">Loading...</option>');

                if (!countryId) {
                    $citySelect.html('<option value="">Select Country First</option>');
                    return;
                }

                $.ajax({
                    url: '/country/get-cities/' + countryId,
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        let options = '<option value="">Select City</option>';
                        $.each(data, function (index, city) {
                            options += '<option value="' + city.id + '">' + city.name + '</option>';
                        });
                        $citySelect.html(options);
                    },
                    error: function () {
                        $citySelect.html('<option value="">Error loading cities</option>');
                    }
                });
            });
        });
    </script>
{% endblock %}
